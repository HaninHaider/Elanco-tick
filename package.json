
{
  
"name": "elanco-tick-tracker",
"version": "1.0.0",
"description": "A full-stack application for tracking UK tick sightings.",
"main": "backend/server.js",


  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch"
  },
  "keywords": [
    "elanco",
    "tick-tracker",
    "full-stack",
    "express",
    "maplibre"
  ],
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
